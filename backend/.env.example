# Copy to .env and fill in real values. Never commit .env.

# Supabase Postgres (Connect → Session pooler string)
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Pilot 2 — AI
GEMINI_API_KEY=

# Pilot 2 — Gmail OAuth (Google Cloud Console → Auth Platform → Clients)
# PILOT2_GMAIL_MODE: "mock" = no Google calls (dev default), "live" = real Gmail
PILOT2_GMAIL_MODE=mock
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/pilot2/inboxes/oauth/callback

# Secret required by /api/pilot2/poll and /api/pilot2/learning/distill in
# production (send as X-Cron-Secret header). Leave empty for open local dev.
PILOT2_CRON_SECRET=

# Optional tuning (defaults shown)
# PILOT2_POLL_INTERVAL_MINUTES=1
# PILOT2_DISTILL_HOUR_UTC=2
# PILOT2_SCHEDULER_ENABLED=true
# PILOT2_MAX_RULES_PER_INTENT=10
