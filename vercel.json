{
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    {
      "src": "backend/index.py",
      "use": "@vercel/python",
      "config": { "includeFiles": "app/**" }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "backend/index.py" },
    { "src": "/health", "dest": "backend/index.py" },
    { "src": "/docs(.*)", "dest": "backend/index.py" },
    { "src": "/openapi.json", "dest": "backend/index.py" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "frontend/index.html" }
  ]
}
